#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

start_service() {
	config_load steward-controller
	local enabled device_port
	config_get_bool enabled controller enabled 0
	config_get device_port controller device_port 15002
	[ "$enabled" = 1 ] || return 0

	mkdir -p /etc/steward/configs
	chmod 700 /etc/steward
	procd_open_instance
	procd_set_param command /usr/sbin/steward-controller --listen "[::]:$device_port" --state-dir /etc/steward
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger steward-controller
}
