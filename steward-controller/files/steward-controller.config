config controller 'controller'
	option enabled '1'
	# Devices connect here (uCentral's WebSocket protocol, over TLS). The
	# controller's certificate authority is created on first start in
	# /etc/steward/tls/: devices pin it, so keep it (sysupgrade does). Each
	# device's configuration is /etc/steward/configs/<serial>.json. New
	# devices wait until adopted: steward-controller devices, then
	# steward-controller adopt <serial>.
	option device_port '15002'
	# The API and the web interface (steward-web), over HTTPS. Sign in with
	# the router's own accounts (root, as for LuCI).
	option web_port '8443'
