config agent 'agent'
	# Off until the agent is implemented.
	option enabled '0'
	# The controller, as wss://<host>:15002. Empty: the default gateway's
	# (the router, which usually hosts it). The first controller reached is
	# pinned in /etc/steward-agent/controller-ca.pem, and adoption leaves a
	# credential for it in /etc/steward-agent/credential. To move this device
	# to another controller, remove both: with a credential and no pin, the
	# agent doesn't connect.
	option controller ''
