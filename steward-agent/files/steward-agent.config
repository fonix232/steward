config agent 'agent'
	option enabled '1'
	# The controller, as wss://<host>:15002. Empty: the one on this device when
	# steward-controller is enabled here (the router that hosts it), otherwise
	# the default gateway's. The first controller reached is pinned in
	# /etc/steward-agent/controller-ca.pem, and adoption leaves a credential
	# for it in /etc/steward-agent/credential. To move this device to another
	# controller, remove both: with a credential and no pin, the agent doesn't
	# connect.
	option controller ''
