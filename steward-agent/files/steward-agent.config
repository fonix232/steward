config agent 'agent'
	# Off until the agent is implemented.
	option enabled '0'
	# The controller, as wss://<host>:15002. Empty: the default gateway's
	# (the router, which usually hosts it). The first controller reached is
	# pinned in /etc/steward-agent/controller-ca.pem: remove that file to
	# move this device to another controller.
	option controller ''
