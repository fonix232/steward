#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

start_service() {
	config_load steward-agent
	local enabled controller
	config_get_bool enabled agent enabled 0
	config_get controller agent controller
	[ "$enabled" = 1 ] || return 0

	procd_open_instance
	procd_set_param command /usr/sbin/steward-agent --state-dir /etc/steward-agent
	[ -z "$controller" ] || procd_append_param command --controller "$controller"
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger steward-agent
}
